{
  "name": "peek-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "dev:hosted": "vite --mode hosted",
    "dev:tunnel": "node ../scripts/dev-tunnel.mjs",
    "deploy:hosted": "tsc --noEmit && cf deploy --mode hosted",
    "build:screen-plugin": "tsc --noEmit && vite build --mode screen-plugin"
  },
  "dependencies": {
    "solid-js": "^1.9.19",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-beta.29",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-solid": "^2.11.16"
  }
}
