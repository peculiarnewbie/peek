{
  "name": "peek-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "dev:hosted": "vite --mode hosted",
    "deploy:hosted": "tsc --noEmit && vite build --mode hosted && cf deploy --prebuilt",
    "build:screen-plugin": "tsc --noEmit && vite build --mode screen-plugin"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.22",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "@tanstack/solid-start": "2.0.0-rc.10",
    "solid-js": "2.0.0-rc.22",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-beta.29",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
