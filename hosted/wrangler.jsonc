// The hosted client: static files only, no Worker code. Browsers connect
// from this page straight to each machine over Tailscale, so nothing about
// the machines passes through Cloudflare.
//
// Deploy: cd client && bun run build:hosted && cd ../hosted && bunx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler@4.160.0/config-schema.json",
  "name": "peek",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../client/dist-hosted",
    // /pair and any other path load the client, which reads the URL itself.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "peek.peculiarnewbie.com", "custom_domain": true }],
  "workers_dev": false
}
